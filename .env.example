PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=patai
SEED_DEMO=true
TZ=America/Sao_Paulo

# No Compass, conecte com a mesma URI e abra o banco patai.
# Opcional, somente para transferir o banco da versão anterior:
# LEGACY_SQLITE_PATH=./data/patai.sqlite

# Em produção: SEED_DEMO=false. Cria o primeiro administrador uma única vez.
# ADMIN_NAME=Administrador
# ADMIN_EMAIL=admin@seudominio.com
# ADMIN_PASSWORD=defina-uma-senha-forte
